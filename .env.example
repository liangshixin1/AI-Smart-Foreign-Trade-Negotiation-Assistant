# ========================================
# AI Smart Foreign Trade Negotiation Assistant
# 环境配置文件示例
# ========================================

# ----------------------------------------
# Neo4j 知识图谱数据库配置
# ----------------------------------------
# 本地Docker部署配置（推荐）
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=foreign-trade-2024

# 云端Aura配置示例（不推荐，已废弃）
# NEO4J_URI=neo4j+s://xxxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-aura-password

# ----------------------------------------
# 数据库配置
# ----------------------------------------
DATABASE_PATH=./app.db

# ----------------------------------------
# AI/LLM 服务配置（DeepSeek，base=https://api.deepseek.com）
# ----------------------------------------
# 实战练习：场景生成（教师「重新生成」固定场景时调用）
DEEPSEEK_GENERATOR_KEY=your-deepseek-generator-key
# 实战练习：模拟谈判对话（actor = David Lim / NovaTech）
DEEPSEEK_COLLAB_KEY=your-deepseek-collab-key
# 评分裁判（可分别配置打分/详情，或用统一的 CRITIC key 兜底）
DEEPSEEK_CRITIC_KEY=your-deepseek-critic-key
# DEEPSEEK_CRITIC_SCORE_KEY=your-deepseek-critic-score-key
# DEEPSEEK_CRITIC_DETAIL_KEY=your-deepseek-critic-detail-key
# 学生写作 Copilot（场外援助）；未配置时回退到 DEEPSEEK_COLLAB_KEY
DEEPSEEK_COPILOT_API_KEY=your-deepseek-copilot-key
# 知识点匹配（DEEPSEEK_KP_API_KEY 优先，回退 DEEPSEEK_API_KEY）
DEEPSEEK_KP_API_KEY=your-deepseek-kp-key
DEEPSEEK_API_KEY=your-deepseek-api-key
# 理论讲解（回退 DEEPSEEK_API_KEY）
DEEPSEEK_LECTURE_API_KEY=your-deepseek-lecture-key
# 知识图谱策略（回退 DEEPSEEK_API_KEY）
DEEPSEEK_STRATEGY_API_KEY=your-deepseek-strategy-key

# ----------------------------------------
# 语音 ASR/TTS（阿里云 DashScope）
# ----------------------------------------
DASHSCOPE_API_KEY=your-dashscope-key
# DASHSCOPE_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
# DASHSCOPE_TTS_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime

# ----------------------------------------
# 应用配置
# ----------------------------------------
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-secret-key-change-this-in-production

# ----------------------------------------
# 日志配置
# ----------------------------------------
LOG_LEVEL=INFO

# ----------------------------------------
# 文件上传配置
# ----------------------------------------
MAX_CONTENT_LENGTH=16777216  # 16MB
UPLOAD_FOLDER=./uploads

# ----------------------------------------
# 部署配置
# ----------------------------------------
# 生产环境请设置为False
DEBUG=True

# ========================================
# 快速开始指南
# ========================================
# 1. 复制此文件为 .env
#    cp .env.example .env
#
# 2. 启动本地Neo4j
#    docker-compose -f docker-compose.neo4j.yml up -d
#
# 3. 配置OpenAI API Key
#    编辑.env文件，填入你的API Key
#
# 4. 安装依赖并启动应用
#    pip install -r requirements.txt
#    python app.py
#
# 5. 访问应用
#    http://localhost:5000
