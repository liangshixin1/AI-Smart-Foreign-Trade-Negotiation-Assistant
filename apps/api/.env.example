# [导读] 用途：后端环境变量示例，供成员了解配置项。
# [导读] 为什么：将部署差异从业务代码中分离；这里只是模板，真实配置还应核对工程根目录环境文件。
# [导读] 提醒：示例值不能替代正式密钥，不要提交或转发含真实凭据的 .env。
APP_ENV=development
DATABASE_URL=sqlite:///./dev.db
CORS_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174"]
AUTH_TOKEN_PEPPER=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=604800
DEV_SEED_PASSWORD=ChangeMe-OnlyForLocalDevelopment

# 本地开发保持 mock；真实手工测试改为 deepseek，并分别配置三把密钥。
LLM_PROVIDER=mock
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_SCENARIO_API_KEY=
DEEPSEEK_CONVERSATION_API_KEY=
DEEPSEEK_EVALUATION_API_KEY=
DEEPSEEK_SCENARIO_MODEL=deepseek-v4-flash
DEEPSEEK_CONVERSATION_MODEL=deepseek-v4-flash
DEEPSEEK_EVALUATION_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# 默认关闭新建 AVG 仿真；完成迁移和本地验收后显式改为 true。
SIMULATION_ENABLED=false

# 默认关闭新建信用证审改模式；完成0018迁移与验收后显式改为 true。
DOCUMENT_CORRECTION_ENABLED=false
# 仅本地验收时临时跳过6-1先修；生产保持 false。
DOCUMENT_CORRECTION_SKIP_PREREQUISITE=false

# 知识图谱正式存储（启动时不连库，发布/查询时才访问）
KNOWLEDGE_GRAPH_PROVIDER=neo4j
NEO4J_URI=bolt://127.0.0.1:17687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_CONNECTION_TIMEOUT_SECONDS=5
